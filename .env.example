# ------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Origens autorizadas a chamar a API (separadas por vírgula).
# Em produção, use a URL do site na Vercel. Ex.: https://tuiajoias.com.br
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ------------------------------------------------------------------
# Local (docker compose): postgresql://USUARIO:SENHA@localhost:5432/BANCO
DATABASE_URL=postgresql://tuia:troque-esta-senha@localhost:5432/tuia_joias
# true em bancos gerenciados (Supabase, Neon, Render...). false no Docker local.
DATABASE_SSL=false

# Usadas apenas pelo docker-compose.yml para criar o Postgres local.
POSTGRES_USER=tuia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=tuia_joias

# ------------------------------------------------------------------
# Autenticação
# ------------------------------------------------------------------
# Gere com: openssl rand -base64 48   (mínimo 32 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------
# Supabase Storage (somente backend — NUNCA expor no frontend)
# ------------------------------------------------------------------
# Veja docs/SUPABASE.md. Em development pode ficar vazio: a API sobe e o
# upload responde 503 até ser configurado. Em production é obrigatório.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Público: imagens otimizadas (WebP) exibidas no site.
SUPABASE_STORAGE_BUCKET=works
# Privado: originais enviados direto pelo navegador, apagados após o processamento.
SUPABASE_UPLOADS_BUCKET=uploads

# ------------------------------------------------------------------
# Regras de negócio
# ------------------------------------------------------------------
MAX_FILE_SIZE_MB=25
MAX_WORKS=15

# ------------------------------------------------------------------
# Otimização de imagem (opcionais)
# ------------------------------------------------------------------
# Lado maior máximo da imagem publicada, em pixels (não amplia fotos menores).
IMAGE_MAX_DIMENSION=2560
# Qualidade do WebP gerado (1–100).
IMAGE_WEBP_QUALITY=86
