# Modelo do .env.test, usado só por `npm run test:e2e`:
#   cp .env.test.example .env.test
# Os testes usam o banco isolado tuia_joias_test (criado pelo docker compose)
# e um storage em memória, então não precisam do Supabase.
NODE_ENV=test
PORT=3101
CORS_ORIGINS=http://localhost:3000
# Mesmo usuário/senha do POSTGRES_* do .env, mas no banco *_test.
DATABASE_URL=postgresql://tuia:troque-esta-senha@localhost:5432/tuia_joias_test
DATABASE_SSL=false
# Qualquer valor com 32+ caracteres (openssl rand -base64 48).
JWT_SECRET=
JWT_EXPIRES_IN=1h
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=works
SUPABASE_UPLOADS_BUCKET=uploads
# Limites baixos de propósito, para os testes de limite rodarem rápido.
MAX_FILE_SIZE_MB=1
MAX_WORKS=3
IMAGE_MAX_DIMENSION=800
IMAGE_WEBP_QUALITY=80
